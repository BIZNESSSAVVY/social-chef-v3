# Optional local AI backend; original Render backend is used if this is blank.
# Use a fresh key. Never place it in public/config.js.
OPENAI_API_KEY=
# Kept from the original backend. Change to a Chat Completions model your account supports.
OPENAI_MODEL=gpt-3.5-turbo
GENERATION_BACKEND_URL=https://social-chef-backend.onrender.com/api/generate-post
PORT=3000
